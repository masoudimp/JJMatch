@page "/"
@using System.Globalization
@using System.Text.Json

<PageTitle>JJMatch Playground</PageTitle>

<h1>JJMatch Playground</h1>
<p>Paste two JSON documents, choose the rules, and compare them with <code>JJMatcher.Match</code>.</p>

<fieldset class="settings">
    <legend>Arrays</legend>
    <label><input type="radio" name="arrays" checked="@(arrayMode == JJArrayMatchingMode.Strict)" @onchange="() => arrayMode = JJArrayMatchingMode.Strict" /> Strict (order and count)</label>
    <label><input type="radio" name="arrays" checked="@(arrayMode == JJArrayMatchingMode.Unordered)" @onchange="() => arrayMode = JJArrayMatchingMode.Unordered" /> Unordered (count only)</label>
    <label><input type="radio" name="arrays" checked="@(arrayMode == JJArrayMatchingMode.StructureOnly)" @onchange="() => arrayMode = JJArrayMatchingMode.StructureOnly" /> StructureOnly (shapes only)</label>
</fieldset>

<fieldset class="settings">
    <legend>Values (combined with OR)</legend>
    <label><input type="checkbox" @bind="exact" /> Exact</label>
    <label><input type="checkbox" @bind="normalized" /> Normalized</label>
    <label><input type="checkbox" @bind="fuzzy" /> Fuzzy</label>
    <label><input type="checkbox" @bind="numeric" /> Numeric</label>
</fieldset>

<fieldset class="settings">
    <legend>Compare (neither selected means both)</legend>
    <label><input type="checkbox" @bind="structuralMatching" /> StructuralMatching</label>
    <label><input type="checkbox" @bind="valueMatching" /> ValueMatching</label>
    <label><input type="checkbox" @bind="parseStringifiedJson" /> ParseStringifiedJson</label>
</fieldset>

<p class="snippet-label">Equivalent call (copy into your code):</p>
<pre class="snippet"><code>@Snippet()</code></pre>

<div class="inputs">
    <label>
        Left JSON
        <textarea @bind="left" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 30 }"></textarea>
    </label>
    <label>
        Right JSON
        <textarea @bind="right" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 31 }"></textarea>
    </label>
</div>

<button @onclick="Compare">Compare</button>

@if (error is not null)
{
    <p class="error">@error</p>
}
else if (result is not null)
{
    <dl class="summary">
        <dt>IsMatch</dt>
        <dd>@result.IsMatch</dd>
        <dt>Score</dt>
        <dd>@Percent(result.Score)</dd>
        <dt>StructuralMatchPercentage</dt>
        <dd>@Percent(result.StructuralMatchPercentage)</dd>
        <dt>ValueMatchPercentage</dt>
        <dd>@Percent(result.ValueMatchPercentage)</dd>
    </dl>

    <h2>Differences (@result.Differences.Count)</h2>
    @if (result.Differences.Count == 0)
    {
        <p>None.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Kind</th><th>Left path</th><th>Right path</th><th>Left value</th><th>Right value</th></tr>
            </thead>
            <tbody>
                @foreach (var difference in result.Differences)
                {
                    <tr>
                        <td>@difference.Kind</td>
                        <td>@difference.LeftPath</td>
                        <td>@difference.RightPath</td>
                        <td>@Raw(difference.LeftValue)</td>
                        <td>@Raw(difference.RightValue)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private string left = "";
    private string right = "";
    private JJMatchResult? result;
    private string? error;

    private JJArrayMatchingMode arrayMode = JJArrayMatchingMode.Strict;
    private bool exact = true, normalized, fuzzy, numeric;
    private bool structuralMatching = true, valueMatching = true, parseStringifiedJson;

    private void Compare()
    {
        result = null;
        error = null;
        try
        {
            result = JJMatcher.Match(left, right, Options(), Settings());
        }
        catch (Exception exception)
        {
            error = $"{exception.GetType().Name}: {exception.Message}";
        }
    }

    // All is zero in the library, so selecting neither option is the same as selecting both.
    private JJMatchOptions Options()
    {
        var options = JJMatchOptions.All;
        if (structuralMatching) options |= JJMatchOptions.StructuralMatching;
        if (valueMatching) options |= JJMatchOptions.ValueMatching;
        return options;
    }

    private JJMatchSettings Settings()
    {
        var valueMode = JJValueMatchingMode.None;
        if (exact) valueMode |= JJValueMatchingMode.Exact;
        if (normalized) valueMode |= JJValueMatchingMode.Normalized;
        if (fuzzy) valueMode |= JJValueMatchingMode.Fuzzy;
        if (numeric) valueMode |= JJValueMatchingMode.Numeric;
        return new JJMatchSettings
        {
            ArrayMode = arrayMode,
            ValueMode = valueMode,
            ParseStringifiedJson = parseStringifiedJson
        };
    }

    // The C# call that reproduces the selected settings, built from the same values Compare uses.
    private string Snippet()
    {
        var options = Options();
        var settings = Settings();
        var optionsText = options == JJMatchOptions.All
            ? nameof(JJMatchOptions) + "." + nameof(JJMatchOptions.All)
            : Flags<JJMatchOptions>(options);
        var valueModeText = settings.ValueMode == JJValueMatchingMode.None
            ? nameof(JJValueMatchingMode) + "." + nameof(JJValueMatchingMode.None)
            : Flags<JJValueMatchingMode>(settings.ValueMode);
        var parseText = settings.ParseStringifiedJson ? "true" : "false";
        return $"JJMatcher.Match(left, right, {optionsText}, new JJMatchSettings {{ ArrayMode = "
            + $"{nameof(JJArrayMatchingMode)}.{settings.ArrayMode}, ValueMode = {valueModeText}, "
            + $"ParseStringifiedJson = {parseText} }});";
    }

    // Writes a non-zero flags value as "Type.A | Type.B" in declaration order.
    private static string Flags<T>(T value) where T : struct, Enum
    {
        var number = Convert.ToInt64(value, CultureInfo.InvariantCulture);
        var parts = Enum.GetValues<T>()
            .Where(member => Convert.ToInt64(member, CultureInfo.InvariantCulture) is var bit && bit != 0 && (number & bit) == bit)
            .Select(member => typeof(T).Name + "." + member);
        return string.Join(" | ", parts);
    }

    private static string Percent(double? value) =>
        value is null ? "n/a" : value.Value.ToString("R", CultureInfo.InvariantCulture) + "%";

    private static string Raw(JsonElement? element) => element?.GetRawText() ?? "";
}
