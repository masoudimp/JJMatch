@page "/"
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>JJMatch Playground</PageTitle>

<div class="container-xl py-4">

<h1 class="h3">JJMatch Playground</h1>
<p class="text-body-secondary">Paste two JSON documents, choose the rules, and compare them with <code>JJMatcher.Match</code>.</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label fw-semibold" for="left">Expected JSON</label>
        <textarea id="left" class="form-control font-monospace json-input" @bind="left" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 30 }"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold" for="right">LLM response JSON</label>
        <textarea id="right" class="form-control font-monospace json-input" @bind="right" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 31 }"></textarea>
    </div>
</div>

<details class="drawer card mb-3">
<summary class="card-header fw-semibold">Settings</summary>
<div class="card-body">

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <section class="border rounded p-3 h-100 position-relative">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Scope</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Compare</legend>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="compare-structural" @bind="structuralMatching" />
                    <label class="form-check-label" for="compare-structural">StructuralMatching</label>
                    @Tip(StructuralTip)
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="compare-value" @bind="valueMatching" />
                    <label class="form-check-label" for="compare-value">ValueMatching</label>
                    @Tip(ValueTip)
                </div>
                <div class="form-text">Neither selected means both.</div>
            </fieldset>

            <label class="form-label fw-semibold mb-1" for="max-depth">MaxDepth</label>
            @Tip(MaxDepthTip)
            <input class="form-control form-control-sm number-input" type="number" id="max-depth" min="1" @bind="maxDepth" />
            <div class="form-text">Deepest nesting allowed, at least 1.</div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="border rounded p-3 h-100 position-relative">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Structure</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Arrays</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="arrays" id="arrays-strict" checked="@(arrayMode == JJArrayMatchingMode.Strict)" @onchange="() => arrayMode = JJArrayMatchingMode.Strict" />
                    <label class="form-check-label" for="arrays-strict">Strict <span class="small text-body-secondary">values and count</span></label>
                    @Tip(StrictTip)
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="arrays" id="arrays-structure" checked="@(arrayMode == JJArrayMatchingMode.StructureOnly)" @onchange="() => arrayMode = JJArrayMatchingMode.StructureOnly" />
                    <label class="form-check-label" for="arrays-structure">StructureOnly <span class="small text-body-secondary">shapes only</span></label>
                    @Tip(StructureOnlyTip)
                </div>
            </fieldset>

            <fieldset>
                <legend class="fs-6 fw-semibold mb-1">Property names</legend>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="names-normalized" @bind="normalizedNames" />
                    <label class="form-check-label" for="names-normalized">Normalized <span class="small text-body-secondary">case, outer white space and Unicode form ignored</span></label>
                    @Tip(NormalizedNamesTip)
                </div>
                <div class="form-text">Identical names always match.</div>
            </fieldset>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="border rounded p-3 h-100 position-relative">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Values</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Match rules</legend>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="values-normalized" @bind="normalized" />
                    <label class="form-check-label" for="values-normalized">Normalized</label>
                    @Tip(NormalizedTip)
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="values-fuzzy" @bind="fuzzy" />
                    <label class="form-check-label" for="values-fuzzy">Fuzzy</label>
                    @Tip(FuzzyTip)
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="values-numeric" @bind="numeric" />
                    <label class="form-check-label" for="values-numeric">Numeric</label>
                    @Tip(NumericTip)
                </div>
                <div class="form-text">Identical values always match. Selected rules are combined with OR.</div>
            </fieldset>

            <label class="form-label fw-semibold mb-1" for="fuzzy-threshold">FuzzyThreshold</label>
            @Tip(FuzzyThresholdTip)
            <input class="form-control form-control-sm number-input" type="number" id="fuzzy-threshold" min="0" max="1" step="0.05" disabled="@(!fuzzy)" @bind="fuzzyThreshold" />
            <div class="form-text">0 to 1, the least similarity Fuzzy accepts. Used only when Fuzzy is selected.</div>
        </section>
    </div>

    <div class="col-12">
        <section class="border rounded p-3 h-100 position-relative">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Scoring</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Mode</legend>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="scoring" id="scoring-standard" checked="@(scoringMode == JJScoringMode.Standard)" @onchange="() => scoringMode = JJScoringMode.Standard" />
                    <label class="form-check-label" for="scoring-standard">Standard <span class="small text-body-secondary">every difference counts fully</span></label>
                    @Tip(StandardTip)
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="scoring" id="scoring-weighted" checked="@(scoringMode == JJScoringMode.Weighted)" @onchange="() => scoringMode = JJScoringMode.Weighted" />
                    <label class="form-check-label" for="scoring-weighted">Weighted <span class="small text-body-secondary">each kind of difference counts by its weight</span></label>
                    @Tip(WeightedTip)
                </div>
            </fieldset>

            <div class="row g-3">
                <div class="col-auto">
                    <label class="form-label fw-semibold mb-1" for="weight-missing">MissingWeight</label>
                    @Tip(MissingWeightTip)
                    <input class="form-control form-control-sm number-input" type="number" id="weight-missing" min="@JJScoringSettings.MinWeight" max="@JJScoringSettings.MaxWeight" disabled="@(scoringMode != JJScoringMode.Weighted)" @bind="missingWeight" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold mb-1" for="weight-added">AddedWeight</label>
                    @Tip(AddedWeightTip)
                    <input class="form-control form-control-sm number-input" type="number" id="weight-added" min="@JJScoringSettings.MinWeight" max="@JJScoringSettings.MaxWeight" disabled="@(scoringMode != JJScoringMode.Weighted)" @bind="addedWeight" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold mb-1" for="weight-type">TypeMismatchWeight</label>
                    @Tip(TypeMismatchWeightTip)
                    <input class="form-control form-control-sm number-input" type="number" id="weight-type" min="@JJScoringSettings.MinWeight" max="@JJScoringSettings.MaxWeight" disabled="@(scoringMode != JJScoringMode.Weighted)" @bind="typeMismatchWeight" />
                </div>
                <div class="col-auto">
                    <label class="form-label fw-semibold mb-1" for="weight-value">ValueMismatchWeight</label>
                    @Tip(ValueMismatchWeightTip)
                    <input class="form-control form-control-sm number-input" type="number" id="weight-value" min="@JJScoringSettings.MinWeight" max="@JJScoringSettings.MaxWeight" disabled="@(scoringMode != JJScoringMode.Weighted)" @bind="valueMismatchWeight" />
                </div>
            </div>
            <div class="form-text">@JJScoringSettings.MinWeight (least important) to @JJScoringSettings.MaxWeight (the Standard cost). Used only when Weighted is selected.</div>
        </section>
    </div>
</div>

<h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Code for the selected settings</h2>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold">C#</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Copy(Snippet())">Copy</button>
        </div>
        <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-csharp">@Snippet()</code></pre>
    </div>
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold">JJSetting.json</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Copy(SettingsJson())">Copy</button>
        </div>
        <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-json">@SettingsJson()</code></pre>
        <p class="form-text mb-0">Load it with <code>JJMatchSettings.FromJson(File.ReadAllText("JJSetting.json"))</code>.</p>
    </div>
</div>

</div>
</details>

<button class="btn btn-primary mb-3" @onclick="Compare">Compare</button>

@if (error is not null)
{
    <div class="alert alert-danger font-monospace error" role="alert">@error</div>
}
else if (result is not null)
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">IsMatch</div>
                    <span class="badge fs-6 @(result.IsMatch ? "text-bg-success" : "text-bg-danger")">@result.IsMatch</span>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">Score</div>
                    <div class="fs-5 text-break">@Percent(result.Score)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">StructuralMatchPercentage</div>
                    <div class="fs-5 text-break">@Percent(result.StructuralMatchPercentage)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">ValueMatchPercentage</div>
                    <div class="fs-5 text-break">@Percent(result.ValueMatchPercentage)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">ElapsedMilliseconds</div>
                    <div class="fs-5 text-break">@result.ElapsedMilliseconds.ToString("0.###", CultureInfo.InvariantCulture) ms</div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Differences <span class="badge text-bg-secondary">@result.Differences.Count</span></h2>
    @if (result.Differences.Count == 0)
    {
        <p class="text-body-secondary">None.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover">
                <thead>
                    <tr><th>Kind</th><th>ScoreWeight</th><th>Left path</th><th>Right path</th><th>Left value</th><th>Right value</th></tr>
                </thead>
                <tbody class="font-monospace small text-break">
                    @foreach (var difference in result.Differences)
                    {
                        <tr>
                            <td>@difference.Kind</td>
                            <td>@difference.ScoreWeight</td>
                            <td>@difference.LeftPath</td>
                            <td>@difference.RightPath</td>
                            <td>@Raw(difference.LeftValue)</td>
                            <td>@Raw(difference.RightValue)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

</div>

@code {
    private string left = "";
    private string right = "";
    private JJMatchResult? result;
    private string? error;

    private JJArrayMatchingMode arrayMode = JJArrayMatchingMode.Strict;
    private bool normalized, fuzzy, numeric, normalizedNames;
    private bool structuralMatching = true, valueMatching = true;
    private int maxDepth = new JJMatchSettings().MaxDepth;
    private double fuzzyThreshold = new JJMatchSettings().FuzzyThreshold;
    private JJScoringMode scoringMode = new JJScoringSettings().Mode;
    private int missingWeight = new JJScoringSettings().MissingWeight;
    private int addedWeight = new JJScoringSettings().AddedWeight;
    private int typeMismatchWeight = new JJScoringSettings().TypeMismatchWeight;
    private int valueMismatchWeight = new JJScoringSettings().ValueMismatchWeight;

    // One tooltip per setting: what it does, then one pair of documents and whether that setting
    // accepts or rejects them. Scoring settings never change that verdict, so their tooltips carry none.
    private static readonly (string Text, string Left, string Right, string Verdict)
        StructuralTip = ("When active, property names, JSON types and nesting are compared. Selected alone, values are ignored.", Object("\"age\": 30"), Object("\"age\": 31"), "Accepted"),
        ValueTip = ("When active, primitive values are compared, using the Values rules.", Object("\"age\": 30"), Object("\"age\": 31"), "Rejected"),
        MaxDepthTip = ("The deepest nesting of objects and arrays a document may have. Deeper input is rejected. At 1:", Object("\"user\": { \"age\": 30 }"), Object("\"user\": { \"age\": 30 }"), "Rejected"),
        StrictTip = ("When active, array elements may be in any order, but each must occur the same number of times.", "[1, 2, 3]", "[3, 2, 1]", "Accepted"),
        StructureOnlyTip = ("When active, only the shapes of array elements are compared. Count and values are ignored.", "[1, 2, 3]", "[9]", "Accepted"),
        NormalizedNamesTip = ("When active, property names match ignoring case, outer white space and Unicode form.", Object("\"age\": 30"), Object("\" Age \": 30"), "Accepted"),
        NormalizedTip = ("When active, strings match ignoring case, outer white space and Unicode form.", Object("\"city\": \"New York\""), Object("\"city\": \" new york \""), "Accepted"),
        FuzzyTip = ("When active, strings match when they are similar enough, tolerating typos.", Object("\"name\": \"John Smith\""), Object("\"name\": \"Jon Smith\""), "Accepted"),
        NumericTip = ("When active, numbers match as quantities, however they are written.", Object("\"age\": 30"), Object("\"age\": 30.0"), "Accepted"),
        StandardTip = ("When active, every difference lowers the score fully, whatever its kind.", Object("\"age\": 30,\n  \"name\": \"Ann\""), Object("\"age\": 30"), ""),
        WeightedTip = ("When active, each kind of difference lowers the score by its weight.", Object("\"age\": 30,\n  \"name\": \"Ann\""), Object("\"age\": 30"), ""),
        MissingWeightTip = ("How much content missing from the response lowers the Weighted score. At 8:", Object("\"age\": 30,\n  \"name\": \"Ann\""), Object("\"age\": 30"), ""),
        AddedWeightTip = ("How much content only the response has lowers the Weighted score. At 3:", Object("\"age\": 30"), Object("\"age\": 30,\n  \"name\": \"Ann\""), ""),
        TypeMismatchWeightTip = ("How much a value of another JSON type lowers the Weighted score. At 10:", Object("\"age\": 30"), Object("\"age\": \"30\""), ""),
        ValueMismatchWeightTip = ("How much a different value of the same type lowers the Weighted score. At 6:", Object("\"age\": 30"), Object("\"age\": 31"), "");

    // "John" vs "Jon" (one edit) and "John" vs "Mary" (four edits) are fixed examples, so only
    // the allowed-edits side of each comparison moves as fuzzyThreshold changes, matching
    // ValueMatcher's own length - Ceiling(threshold * length) rule (see src/JJMatch/Internal/Matching/ValueMatcher.cs).
    private (string Text, (string Left, string Right, string Verdict) Close, (string Left, string Right, string Verdict) Far) FuzzyThresholdTip
    {
        get
        {
            const int length = 4; // "John".Length, the longer of the example strings
            const int closeDistance = 1; // edits from "John" to "Jon"
            const int farDistance = 4; // edits from "John" to "Mary"
            var thresholdText = fuzzyThreshold.ToString("0.##", CultureInfo.InvariantCulture);
            var allowedEdits = length - (int)Math.Ceiling(fuzzyThreshold * length);
            var charsPerEdit = fuzzyThreshold >= 1
                ? "any"
                : (1 / (1 - fuzzyThreshold)).ToString("0.#", CultureInfo.InvariantCulture);
            return (
                $"The least similarity Fuzzy accepts: {thresholdText} allows one edit for every {charsPerEdit} characters. At {thresholdText}:",
                (Object("\"name\": \"John\""), Object("\"name\": \"Jon\""), closeDistance <= allowedEdits ? "Accepted" : "Rejected"),
                (Object("\"name\": \"John\""), Object("\"name\": \"Mary\""), farDistance <= allowedEdits ? "Accepted" : "Rejected"));
        }
    }

    private static string Object(string properties) => "{\n  " + properties + "\n}";

    private RenderFragment Tip((string Text, string Left, string Right, string Verdict) tip) => @<span class="tip" tabindex="0">
        <span class="badge rounded-pill text-bg-secondary">?</span>
        <span class="tip-body card shadow p-2 small" role="tooltip">
            <span class="d-block mb-2">@tip.Text</span>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.Left</code>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.Right</code>
            @if (tip.Verdict != "")
            {
                <span class="badge align-self-start @(tip.Verdict == "Accepted" ? "text-bg-success" : "text-bg-danger")">@tip.Verdict</span>
            }
        </span>
    </span>;

    private RenderFragment Tip((string Text, (string Left, string Right, string Verdict) Active, (string Left, string Right, string Verdict) NotActive) tip) => @<span class="tip" tabindex="0">
        <span class="badge rounded-pill text-bg-secondary">?</span>
        <span class="tip-body card shadow p-2 small" role="tooltip">
            <span class="d-block mb-2">@tip.Text</span>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.Active.Left</code>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.Active.Right</code>
            <span class="badge align-self-start mb-2 @(tip.Active.Verdict == "Accepted" ? "text-bg-success" : "text-bg-danger")">@tip.Active.Verdict</span>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.NotActive.Left</code>
            <code class="tip-json border rounded bg-body-tertiary p-1 mb-1">@tip.NotActive.Right</code>
            <span class="badge align-self-start @(tip.NotActive.Verdict == "Accepted" ? "text-bg-success" : "text-bg-danger")">@tip.NotActive.Verdict</span>
        </span>
    </span>;

    private void Compare()
    {
        result = null;
        error = null;
        try
        {
            result = JJMatcher.Match(left, right, Options(), Settings());
        }
        catch (Exception exception)
        {
            error = $"{exception.GetType().Name}: {exception.Message}";
        }
    }

    // All is zero in the library, so selecting neither option is the same as selecting both.
    private JJMatchOptions Options()
    {
        var options = JJMatchOptions.All;
        if (structuralMatching) options |= JJMatchOptions.StructuralMatching;
        if (valueMatching) options |= JJMatchOptions.ValueMatching;
        return options;
    }

    private JJMatchSettings Settings()
    {
        var valueMode = JJValueMatchingMode.None;
        if (normalized) valueMode |= JJValueMatchingMode.Normalized;
        if (fuzzy) valueMode |= JJValueMatchingMode.Fuzzy;
        if (numeric) valueMode |= JJValueMatchingMode.Numeric;
        return new JJMatchSettings
        {
            ArrayMode = arrayMode,
            ValueMode = valueMode,
            PropertyNameMode = normalizedNames ? JJPropertyNameMatchingMode.Normalized : JJPropertyNameMatchingMode.None,
            FuzzyThreshold = fuzzyThreshold,
            MaxDepth = maxDepth,
            Scoring =
            {
                Mode = scoringMode,
                MissingWeight = missingWeight,
                AddedWeight = addedWeight,
                TypeMismatchWeight = typeMismatchWeight,
                ValueMismatchWeight = valueMismatchWeight
            }
        };
    }

    // The C# code that reproduces the selected settings, built from the same values Compare uses.
    // Rendered as highlighted HTML; every token is an identifier or keyword, so no escaping is needed.
    private MarkupString Snippet()
    {
        var options = Options();
        var settings = Settings();
        var optionsText = options == JJMatchOptions.All
            ? Member(nameof(JJMatchOptions), nameof(JJMatchOptions.All))
            : Flags<JJMatchOptions>(options);
        var valueModeText = settings.ValueMode == JJValueMatchingMode.None
            ? Member(nameof(JJValueMatchingMode), nameof(JJValueMatchingMode.None))
            : Flags<JJValueMatchingMode>(settings.ValueMode);
        var arrayModeText = Member(nameof(JJArrayMatchingMode), settings.ArrayMode.ToString());
        var nameModeText = Member(nameof(JJPropertyNameMatchingMode), settings.PropertyNameMode.ToString());
        var scoringModeText = Member(nameof(JJScoringMode), settings.Scoring.Mode.ToString());
        var varKeyword = Keyword("var");
        var newKeyword = Keyword("new");
        // Two dollar signs: {{ }} interpolates, so the single braces of the object initializer are literal.
        return new MarkupString($$"""
            {{varKeyword}} settings = {{newKeyword}} {{Type(nameof(JJMatchSettings))}}
            {
                ArrayMode = {{arrayModeText}},
                ValueMode = {{valueModeText}},
                PropertyNameMode = {{nameModeText}},
                FuzzyThreshold = {{Number(settings.FuzzyThreshold)}},
                MaxDepth = {{Number(settings.MaxDepth)}},
                Scoring =
                {
                    Mode = {{scoringModeText}},
                    MissingWeight = {{Number(settings.Scoring.MissingWeight)}},
                    AddedWeight = {{Number(settings.Scoring.AddedWeight)}},
                    TypeMismatchWeight = {{Number(settings.Scoring.TypeMismatchWeight)}},
                    ValueMismatchWeight = {{Number(settings.Scoring.ValueMismatchWeight)}}
                }
            };
            {{varKeyword}} result = {{Type(nameof(JJMatcher))}}.Match(expectedJson, llmResponseJson, {{optionsText}}, settings);
            """);
    }

    // The JJSetting.json that JJMatchSettings.FromJson reads back into the same settings. Rendered as highlighted
    // HTML; names are identifiers and values are member names or digits, so no escaping is needed.
    private MarkupString SettingsJson()
    {
        var settings = Settings();
        var valueModeText = settings.ValueMode == JJValueMatchingMode.None
            ? nameof(JJValueMatchingMode.None)
            : settings.ValueMode.ToString().Replace(", ", " | ");
        return new MarkupString($$"""
            {
              {{Name(nameof(JJMatchSettings.ArrayMode))}}: {{Text(settings.ArrayMode.ToString())}},
              {{Name(nameof(JJMatchSettings.ValueMode))}}: {{Text(valueModeText)}},
              {{Name(nameof(JJMatchSettings.PropertyNameMode))}}: {{Text(settings.PropertyNameMode.ToString())}},
              {{Name(nameof(JJMatchSettings.FuzzyThreshold))}}: {{Number(settings.FuzzyThreshold)}},
              {{Name(nameof(JJMatchSettings.MaxDepth))}}: {{Number(settings.MaxDepth)}},
              {{Name(nameof(JJMatchSettings.Scoring))}}: {
                {{Name(nameof(JJScoringSettings.Mode))}}: {{Text(settings.Scoring.Mode.ToString())}},
                {{Name(nameof(JJScoringSettings.MissingWeight))}}: {{Number(settings.Scoring.MissingWeight)}},
                {{Name(nameof(JJScoringSettings.AddedWeight))}}: {{Number(settings.Scoring.AddedWeight)}},
                {{Name(nameof(JJScoringSettings.TypeMismatchWeight))}}: {{Number(settings.Scoring.TypeMismatchWeight)}},
                {{Name(nameof(JJScoringSettings.ValueMismatchWeight))}}: {{Number(settings.Scoring.ValueMismatchWeight)}}
              }
            }
            """);
    }

    // Copies a rendered snippet as plain text. Every tag is a highlighting span around plain tokens, so stripping
    // the tags gives the text as displayed. Without clipboard access the snippet still selects whole on click.
    private async Task Copy(MarkupString snippet)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Regex.Replace(snippet.Value, "<[^>]+>", ""));
        }
        catch (JSException)
        {
        }
    }

    // Writes a non-zero flags value as "Type.A | Type.B" in declaration order.
    private static string Flags<T>(T value) where T : struct, Enum
    {
        var number = Convert.ToInt64(value, CultureInfo.InvariantCulture);
        var parts = Enum.GetValues<T>()
            .Where(member => Convert.ToInt64(member, CultureInfo.InvariantCulture) is var bit && bit != 0 && (number & bit) == bit)
            .Select(member => Member(typeof(T).Name, member.ToString()));
        return string.Join(" | ", parts);
    }

    private static string Keyword(string text) => $"<span class=\"kw\">{text}</span>";
    private static string Type(string text) => $"<span class=\"ty\">{text}</span>";
    private static string Member(string type, string member) => Type(type) + "." + member;
    private static string Number(int value) => $"<span class=\"num\">{value.ToString(CultureInfo.InvariantCulture)}</span>";
    // "R" keeps every digit of the value, so the snippet reproduces the exact threshold the comparison used.
    private static string Number(double value) => $"<span class=\"num\">{value.ToString("R", CultureInfo.InvariantCulture)}</span>";
    private static string Name(string text) => $"<span class=\"pn\">\"{text}\"</span>";
    private static string Text(string text) => $"<span class=\"str\">\"{text}\"</span>";

    private static string Percent(double? value) =>
        value is null ? "n/a" : value.Value.ToString("R", CultureInfo.InvariantCulture) + "%";

    private static string Raw(JsonElement? element) => element?.GetRawText() ?? "";
}
