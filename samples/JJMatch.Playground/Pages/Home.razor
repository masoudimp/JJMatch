    private RenderFragment JsonEditor(Side side, string id, string label, string placeholder)
    {
        var status = Status(side);
        var text = side == Side.Left ? left : right;
        var formatError = formatErrors.GetValueOrDefault(side);
        return @<div class="col-md-6">
            <div class="d-flex align-items-center gap-2 mb-1">
                <label class="form-label fw-semibold mb-0 me-auto" for="@id">@label</label>
                <span class="json-status small @status.Css" title="@status.Detail">@status.Text</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Pretty-print the document" disabled="@(!status.Ok)" @onclick="() => Format(side)">Format</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Wrap the document in a JSON string, which is decoded again when compared" disabled="@(!status.Ok)" @onclick="() => Stringify(side)">Stringify</button>
            </div>
            <textarea id="@id" class="form-control font-monospace json-input @(status.Ok || text.Length == 0 ? "" : "is-invalid")" spellcheck="false" placeholder="@placeholder"
                      @bind:get="text" @bind:set="value => SetText(side, value)" @bind:event="oninput"></textarea>
            @if (formatError is not null)
            {
                <div class="form-text text-danger">@formatError</div>
            }
        </div>;
    }

