    private RenderFragment CopyButton(string key, MarkupString snippet)
    {
        var feedback = copyFeedback.GetValueOrDefault(key);
        var css = feedback switch
        {
            "Copied" => "btn-success",
            "Copy failed" => "btn-danger",
            _ => "btn-outline-secondary"
        };
        return @<button type="button" class="btn btn-sm @css" @onclick="() => Copy(key, snippet)">@(feedback ?? "Copy")</button>;
