@page "/"
@using System.Globalization
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>JJMatch Playground</PageTitle>

<div class="container-xl pb-4" @onkeydown="OnKeyDown">

<header class="toolbar d-flex flex-wrap align-items-center gap-2 py-2 mb-3 border-bottom">
    <h1 class="h4 mb-0 me-auto">JJMatch Playground</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary" title="Load the documented example pair" @onclick="LoadExample">Load example</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" title="Exchange the two documents" @onclick="Swap" disabled="@(left.Length == 0 && right.Length == 0)">Swap</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Clear" disabled="@(left.Length == 0 && right.Length == 0 && result is null && error is null)">Clear</button>
    <button type="button" class="btn btn-primary" @onclick="Compare" disabled="@(!CanCompare)" title="@CompareHint">Compare</button>
    <span class="small text-body-secondary d-none d-md-inline" aria-hidden="true"><kbd>@(mac ? "⌘" : "Ctrl")</kbd> + <kbd>Enter</kbd></span>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CycleTheme" title="Switch theme">Theme: @ThemeLabel</button>
</header>

<p class="text-body-secondary">Paste two JSON documents, choose the rules, and compare them with <code>JJMatcher.Match</code>.</p>

<div class="row g-3 mb-3">
    @JsonEditor(Side.Left, "left", "Expected JSON", "{ \"name\": \"Ann\", \"age\": 30 }")
    @JsonEditor(Side.Right, "right", "LLM response JSON", "{ \"name\": \"Ann\", \"age\": 31 }")
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3" role="group" aria-label="Starting settings">
    <span class="fw-semibold">Start with:</span>
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(JJMatchSettings.Default)">Default / reset</button>
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(JJMatchSettings.Normalized)">Normalized text and numbers</button>
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyPreset(JJMatchSettings.StructureOnly)">Structure only</button>
</div>
<p class="form-text">Defaults ignore array order, preserve repeated elements, and decode strings containing JSON objects or arrays. Customize below.</p>

<details class="drawer card mb-3">
<summary class="card-header">
    <span class="fw-semibold me-1">Customize settings</span>
    @if (!SettingsValid)
    {
        <span class="badge text-bg-danger me-1">Invalid</span>
    }
    <span class="settings-summary small text-body-secondary">@SettingsSummary</span>
</summary>
<div class="card-body">

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <section class="border rounded p-3 h-100">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Scope</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Compare</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="scope" id="scope-all" checked="@(scope == JJMatchOptions.All)" @onchange="() => scope = JJMatchOptions.All" />
                    <label class="form-check-label" for="scope-all">Full <span class="small text-body-secondary">structure and values</span></label>
                    @Tip("scope-all", AllTip)
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="scope" id="scope-structural" checked="@(scope == JJMatchOptions.StructuralMatching)" @onchange="() => scope = JJMatchOptions.StructuralMatching" />
                    <label class="form-check-label" for="scope-structural">Structure only <span class="small text-body-secondary">values ignored</span></label>
                    @Tip("scope-structural", StructuralTip)
                </div>
            </fieldset>

            <details>
                <summary>Advanced: limits and diagnostics</summary>
                <div class="mt-3">
            <label class="form-label fw-semibold mb-1" for="max-depth">MaxDepth</label>
            @Tip("max-depth", MaxDepthTip)
            <input class="form-control form-control-sm number-input @Invalid(MaxDepthError)" type="number" id="max-depth" min="1" step="1" inputmode="numeric" aria-describedby="max-depth-help" @bind="maxDepth" @bind:event="oninput" />
            @Feedback(MaxDepthError)
            <div id="max-depth-help" class="form-text">Deepest nesting allowed, at least 1.</div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="structural-score" @bind="includeStructuralScore" />
                        <label class="form-check-label" for="structural-score">Compute separate structural score</label>
                        @Tip("structural-score", StructuralScoreTip)
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="decode-json" @bind="decodeStringifiedJson" />
                        <label class="form-check-label" for="decode-json">Decode strings containing JSON objects or arrays</label>
                        @Tip("decode-json", DecodeJsonTip)
                    </div>
                </div>
            </details>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="border rounded p-3 h-100">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Structure</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Arrays</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="arrays" id="arrays-strict" checked="@(arrayMode == JJArrayMatchingMode.Strict)" @onchange="() => arrayMode = JJArrayMatchingMode.Strict" />
                    <label class="form-check-label" for="arrays-strict">Unordered <span class="small text-body-secondary">values and repeated elements count</span></label>
                    @Tip("arrays-strict", StrictTip)
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="arrays" id="arrays-structure" checked="@(arrayMode == JJArrayMatchingMode.StructureOnly)" @onchange="() => arrayMode = JJArrayMatchingMode.StructureOnly" />
                    <label class="form-check-label" for="arrays-structure">Distinct shapes <span class="small text-body-secondary">ignores values and repeated shapes</span></label>
                    @Tip("arrays-structure", StructureOnlyTip)
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Property names</legend>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="names-normalized" @bind="normalizedNames" />
                    <label class="form-check-label" for="names-normalized">Normalized <span class="small text-body-secondary">case, outer white space and Unicode form ignored</span></label>
                    @Tip("names-normalized", NormalizedNamesTip)
                </div>
                <div class="form-text">Identical names always match.</div>
            </fieldset>

            <label class="form-label fw-semibold mb-1" for="ignored-prefix">IgnoredPropertyPrefix</label>
            @Tip("ignored-prefix", IgnoredPrefixTip)
            <input class="form-control form-control-sm" type="text" id="ignored-prefix" placeholder="_ or * or ignore_" autocomplete="off" spellcheck="false" aria-describedby="ignored-prefix-help" @bind="ignoredPrefix" @bind:event="oninput" />
            <div id="ignored-prefix-help" class="form-text">Your own marker: properties whose name starts with this text (<code>_</code>, <code>*</code>, <code>ignore_</code>, …) are removed from both documents before comparing, at every level. Empty keeps every property.</div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="border rounded p-3 h-100">
            <h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Values</h2>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Match rules</legend>
                <label for="strings" class="form-label">Strings</label>
                @Tip("strings", StringsTip)
                <select id="strings" class="form-select mb-2" @bind="SelectedStringComparison">
                    <option value="@JJStringComparison.Exact">Exact text</option>
                    <option value="@JJStringComparison.Normalized">Normalized: ignore case and outer whitespace</option>
                    <option value="@JJStringComparison.Fuzzy">Fuzzy: also accept small typos</option>
                </select>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="values-numeric" @bind="numeric" />
                    <label class="form-check-label" for="values-numeric">Compare numbers by quantity (1 = 1.0)</label>
                    @Tip("values-numeric", NumericTip)
                </div>
                <div class="form-text">Identical values always match. String and number rules are independent.</div>
            </fieldset>

            @if (fuzzy)
            {
            <label class="form-label fw-semibold mb-1" for="fuzzy-threshold">FuzzyThreshold</label>
            @Tip("fuzzy-threshold", FuzzyThresholdTip)
            <input class="form-control form-control-sm number-input @Invalid(FuzzyThresholdError)" type="number" id="fuzzy-threshold" min="0" max="1" step="0.05" inputmode="decimal" aria-describedby="fuzzy-threshold-help" disabled="@(!fuzzy)" @bind="fuzzyThreshold" @bind:event="oninput" />
            @Feedback(FuzzyThresholdError)
            <div id="fuzzy-threshold-help" class="form-text">0 to 1, the least similarity Fuzzy accepts. Used only when Fuzzy is selected.</div>
            }
        </section>
    </div>

    <div class="col-12">
        <section class="border rounded p-3 h-100">
            <details>
            <summary class="fw-semibold">Advanced: scoring weights</summary>
            <p class="form-text">Weights change only the score. Different Missing and Added weights make the score depend on input direction.</p>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-1">Mode</legend>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="scoring" id="scoring-standard" checked="@(scoringMode == JJScoringMode.Standard)" @onchange="() => SetScoringMode(JJScoringMode.Standard)" />
                    <label class="form-check-label" for="scoring-standard">Standard <span class="small text-body-secondary">every difference counts fully</span></label>
                    @Tip("scoring-standard", StandardTipText, ScoreExample(ModeExampleLeft, ModeExampleRight, JJScoringMode.Standard))
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="scoring" id="scoring-weighted" checked="@(scoringMode == JJScoringMode.Weighted)" @onchange="() => SetScoringMode(JJScoringMode.Weighted)" />
                    <label class="form-check-label" for="scoring-weighted">Weighted <span class="small text-body-secondary">each kind of difference counts by its weight</span></label>
                    @Tip("scoring-weighted", WeightedTipText, ScoreExample(ModeExampleLeft, ModeExampleRight, JJScoringMode.Weighted))
                </div>
            </fieldset>

            @if (scoringMode == JJScoringMode.Weighted)
            {
            <div class="row g-3">
                @foreach (var weight in weights)
                {
                    <div class="col-auto">
                        <label class="form-label fw-semibold mb-1" for="@weight.Id">@weight.Name</label>
                        @Tip(weight.Id, weight.TipText, ScoreExample(weight.ExampleLeft, weight.ExampleRight, JJScoringMode.Weighted))
                        <input class="form-control form-control-sm number-input @Invalid(WeightError(weight))" type="number" id="@weight.Id" min="@JJScoringSettings.MinWeight" max="@JJScoringSettings.MaxWeight" step="1" inputmode="numeric" disabled="@(scoringMode != JJScoringMode.Weighted)" @bind="weight.Value" @bind:event="oninput" />
                        @Feedback(WeightError(weight))
                    </div>
                }
            </div>
            <div class="form-text">@JJScoringSettings.MinWeight (least important) to @JJScoringSettings.MaxWeight (the Standard cost). Used only when Weighted is selected.</div>
            }
            </details>
        </section>
    </div>
</div>

<h2 class="text-uppercase small fw-semibold text-body-secondary mb-3">Code for the selected settings</h2>
@if (!SettingsValid)
{
    <div class="alert alert-warning mb-0" role="alert">Fix the highlighted settings to see the code.</div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-semibold">C#</span>
                @CopyButton("csharp", Snippet())
            </div>
            <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-csharp">@Snippet()</code></pre>
        </div>
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-semibold">JJSetting.json</span>
                @CopyButton("json", SettingsJson())
            </div>
            <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-json">@SettingsJson()</code></pre>
            <p class="form-text mb-0">Load it with <code>JJMatchSettings.FromJson(File.ReadAllText("JJSetting.json"))</code>.</p>
        </div>
    </div>
}

</div>
</details>

@if (error is not null)
{
    <section id="results" class="results">
        <div class="alert alert-danger error" role="alert">
            <div class="fw-semibold mb-1">Comparison failed</div>
            <div class="font-monospace small">@error</div>
        </div>
    </section>
}
else if (result is not null)
{
    <section id="results" class="results">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Result</h2>
            <span class="badge fs-6 @(result.IsMatch ? "text-bg-success" : "text-bg-danger")">@(result.IsMatch ? "Match" : "No match")</span>
            <code class="small text-body-secondary">IsMatch = @(result.IsMatch ? "true" : "false")</code>
        </div>

        <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
            @Metric("Score", nameof(JJMatchResult.Score), Percent(result.Score))
        </div>
        <details class="mb-3">
            <summary>Diagnostics</summary>
            <div class="row g-3 mt-1">
                @Metric("Structural score", "Diagnostics.StructuralScore", Percent(result.Diagnostics.StructuralScore))
                @Metric("Elapsed", "Diagnostics.ElapsedMilliseconds", result.Diagnostics.ElapsedMilliseconds.ToString("0.###", CultureInfo.InvariantCulture) + " ms")
            </div>
        </details>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0 me-2">Differences <span class="badge text-bg-secondary">@result.Differences.Count</span></h2>
            @foreach (var group in result.Differences.GroupBy(difference => difference.Kind).OrderBy(group => group.Key))
            {
                var shown = !hiddenKinds.Contains(group.Key);
                <button type="button" class="btn btn-sm kind-chip @(shown ? KindButtonClass(group.Key) : "btn-outline-secondary")" aria-pressed="@(shown ? "true" : "false")" title="@(shown ? "Hide" : "Show") @group.Key differences" @onclick="() => ToggleKind(group.Key)">
                    @group.Key <span class="badge text-bg-light ms-1">@group.Count()</span>
                </button>
            }
        </div>

        @if (result.Differences.Count == 0)
        {
            <p class="text-body-secondary">None.</p>
        }
        else if (VisibleDifferences.Count == 0)
        {
            <p class="text-body-secondary">Every kind is hidden. Select a kind above to show its differences.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-top">
                    <thead>
                        <tr>
                            <th>Kind</th>
                            @if (resultWeighted)
                            {
                                <th>ScoreWeight</th>
                            }
                            <th>Left path</th>
                            <th>Right path</th>
                            <th>Left value</th>
                            <th>Right value</th>
                        </tr>
                    </thead>
                    <tbody class="font-monospace small">
                        @foreach (var (difference, row) in VisibleDifferences)
                        {
                            <tr>
                                <td><span class="badge @KindBadgeClass(difference.Kind)">@difference.Kind</span></td>
                                @if (resultWeighted)
                                {
                                    <td>@difference.ScoreWeight</td>
                                }
                                <td class="difference-path">@PathOrDash(difference.LeftPath)</td>
                                <td class="difference-path">@PathOrDash(difference.RightPath)</td>
                                <td>@ValueCell(row, Side.Left, difference.LeftValue)</td>
                                <td>@ValueCell(row, Side.Right, difference.RightValue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

</div>

@code {
    private enum Side { Left, Right }

    private string left = "";
    private string right = "";
    private JJMatchResult? result;
    private bool resultWeighted;
    private string? error;
    private bool revealResults;
    private string theme = "auto";
    private bool mac;

    private JJMatchOptions scope = JJMatchOptions.All;
    private JJArrayMatchingMode arrayMode = JJArrayMatchingMode.Strict;
    private bool normalized, fuzzy, numeric, normalizedNames;
    private bool includeStructuralScore = true, decodeStringifiedJson = true;

    private JJStringComparison SelectedStringComparison
    {
        get => fuzzy ? JJStringComparison.Fuzzy : normalized ? JJStringComparison.Normalized : JJStringComparison.Exact;
        set
        {
            fuzzy = value == JJStringComparison.Fuzzy;
            normalized = value == JJStringComparison.Normalized;
            OnFuzzyChanged();
        }
    }

    private void ApplyPreset(JJMatchSettings settings)
    {
        scope = settings.Mode == JJComparisonMode.StructureOnly ? JJMatchOptions.StructuralMatching : JJMatchOptions.All;
        arrayMode = settings.ArrayMode;
        SelectedStringComparison = settings.StringComparison;
        numeric = settings.NumberComparison == JJNumberComparison.Numeric;
        normalizedNames = settings.PropertyNameMode == JJPropertyNameMatchingMode.Normalized;
        ignoredPrefix = settings.IgnoredPropertyPrefix ?? "";
        maxDepth = settings.Limits.MaxDepth;
        fuzzyThreshold = settings.FuzzyThreshold;
        includeStructuralScore = settings.IncludeStructuralScore;
        decodeStringifiedJson = settings.DecodeStringifiedJson;
        scoringMode = settings.Scoring.Mode;
        foreach (var weight in weights) weight.Value = weight.Default;
        result = null;
        error = null;
    }
    private string ignoredPrefix = "";
    private int? maxDepth = new JJMatchSettings().MaxDepth;
    private double? fuzzyThreshold = new JJMatchSettings().FuzzyThreshold;
    private JJScoringMode scoringMode = new JJScoringSettings().Mode;

    private readonly HashSet<JJDifferenceKind> hiddenKinds = new();
    private readonly HashSet<(int Row, Side Side)> expandedValues = new();
    private readonly Dictionary<string, string> copyFeedback = new();
    private readonly Dictionary<Side, (string Text, JsonStatus Status)> statusCache = new();
    private readonly Dictionary<Side, string?> formatErrors = new();

    // A long difference value is shown clamped with a Show more control.
    private const int ValuePreviewLength = 160;

    private readonly record struct JsonStatus(bool Ok, string Text, string? Detail, string Css);
    private readonly record struct Example(string Left, string Right, string Badge, string BadgeClass, string? Note = null, string Heading = "Example");
    private sealed record TipContent(string Title, string Text, string Context, Example[] Examples,
        string? Checked = null, string? Unchecked = null);

    // One weight input per JJDifferenceKind, with an example pair that holds exactly one difference of that kind.
    private sealed class WeightInput
    {
        public WeightInput(string id, string name, int defaultValue, string description, string exampleLeft, string exampleRight)
        {
            Id = id;
            Name = name;
            Default = defaultValue;
            Value = defaultValue;
            Description = description;
            ExampleLeft = exampleLeft;
            ExampleRight = exampleRight;
        }

        public string Id { get; }
        public string Name { get; }
        public int Default { get; }
        public int? Value { get; set; }
        public string Description { get; }
        public string ExampleLeft { get; }
        public string ExampleRight { get; }

        public string TipText => Value is int value
            ? $"{Description} Current weight: {value}. A lower weight reduces the penalty; 10 applies the Standard cost. Matching rules and reported differences stay the same."
            : $"{Description} Enter a weight from 1 to 10 to see its effect.";
    }

    private static readonly JJScoringSettings DefaultScoring = new();

    private readonly WeightInput[] weights =
    {
        new("weight-missing", nameof(JJScoringSettings.MissingWeight), DefaultScoring.MissingWeight,
            "How much content missing from the response lowers the Weighted score.",
            Object("\"name\": \"Ann\",\n  \"age\": 30"), Object("\"name\": \"Ann\"")),
        new("weight-added", nameof(JJScoringSettings.AddedWeight), DefaultScoring.AddedWeight,
            "How much content only the response has lowers the Weighted score.",
            Object("\"name\": \"Ann\""), Object("\"name\": \"Ann\",\n  \"age\": 30")),
        new("weight-type", nameof(JJScoringSettings.TypeMismatchWeight), DefaultScoring.TypeMismatchWeight,
            "How much a value of another JSON type lowers the Weighted score.",
            Object("\"name\": \"Ann\",\n  \"age\": 30"), Object("\"name\": \"Ann\",\n  \"age\": \"30\"")),
        new("weight-value", nameof(JJScoringSettings.ValueMismatchWeight), DefaultScoring.ValueMismatchWeight,
            "How much a different value of the same type lowers the Weighted score.",
            Object("\"name\": \"Ann\",\n  \"age\": 30"), Object("\"name\": \"Ann\",\n  \"age\": 31")),
        new("weight-name-case", nameof(JJScoringSettings.PropertyNameCaseMismatchWeight), DefaultScoring.PropertyNameCaseMismatchWeight,
            "How much a property name differing only in case lowers the Weighted score.",
            Object("\"name\": \"Ann\",\n  \"age\": 30"), Object("\"Name\": \"Ann\",\n  \"age\": 30")),
        new("weight-value-case", nameof(JJScoringSettings.ValueCaseMismatchWeight), DefaultScoring.ValueCaseMismatchWeight,
            "How much a string value differing only in case, outer white space or Unicode form lowers the Weighted score.",
            Object("\"name\": \"Ann\",\n  \"city\": \"Oslo\""), Object("\"name\": \"Ann\",\n  \"city\": \"oslo\"")),
    };

    // The Load example pair is publicApi.playground of the test fixtures, embedded by the project file and pinned by
    // JJMatcherIntegrationTests: every documented behavior shows in one comparison, and every setting changes its
    // outcome. The raw fixture text is kept, escapes included, so what the page shows is what the tests compare.
    private static readonly Lazy<(string Left, string Right)> ExamplePair = new(() => (ExampleSection("Left"), ExampleSection("Right")));

    private static string ExampleSection(string side)
    {
        using var stream = typeof(Home).Assembly.GetManifestResourceStream($"Fixtures.{side}.json")
            ?? throw new InvalidOperationException($"The {side} fixture is not embedded.");
        using var reader = new StreamReader(stream);
        // The fixture envelope holds a 100-level stress array, hence the depth; the section itself is shallow.
        using var document = JsonDocument.Parse(reader.ReadToEnd(), new JsonDocumentOptions { MaxDepth = 128 });
        var section = document.RootElement.GetProperty("publicApi").GetProperty("playground").GetRawText();
        // The section sits two levels into the fixture; its continuation lines carry that indentation.
        return section.Replace("\n    ", "\n");
    }

    // Teaching examples use explicit, fixed rules; score previews below use the live settings.
    private const string DefaultExampleContext = "Examples use Full comparison and default settings, except for the rule described here.";

    private static readonly TipContent
        AllTip = new("Full comparison", "Compare property names, JSON types, nesting and values. The selected string, number and array rules still apply.",
            DefaultExampleContext,
            [Verdict("{ \"age\": 30 }", "{ \"age\": 30 }", true, "Same name, type and value."),
             Verdict("{ \"age\": 30 }", "{ \"age\": 31 }", false, "The number changed.")]),
        StructuralTip = new("Structure only", "Compare property names, JSON types and nesting. Ignore primitive values throughout the document. Array counts still follow the selected array rule.",
            "Examples use Structure only with default settings.",
            [Verdict("{ \"age\": 30 }", "{ \"age\": 31 }", true, "Both properties contain a number."),
             Verdict("{ \"age\": 30 }", "{ \"age\": \"30\" }", false, "A number and a string have different JSON types.")]),
        MaxDepthTip = new("Maximum nesting depth", "Limit how deeply objects and arrays can be nested. The outermost object or array is level 1. Enter a whole number of at least 1.",
            "Examples use MaxDepth = 1. Exceeding the limit causes an input error, not a comparison result.",
            [new("{ \"age\": 30 }", "{ \"age\": 30 }", "Within limit", "text-bg-success", "One object level; comparison can run."),
             new("{ \"user\": { \"age\": 30 } }", "{ \"user\": { \"age\": 30 } }", "Input error", "text-bg-warning", "Two object levels; raise MaxDepth to at least 2.")]),
        StrictTip = new("Unordered arrays", "Ignore element order, but preserve the number of occurrences. Each element can pair with only one element in the other array. Values follow the selected comparison rules.",
            DefaultExampleContext,
            [Verdict("[1, 2, 3]", "[3, 2, 1]", true, "Only the order changed."),
             Verdict("[1, 1, 2]", "[1, 2]", false, "The response is missing one occurrence of 1.")]),
        StructureOnlyTip = new("Distinct array shapes", "Compare the different shapes present in each array. Ignore order, repeated shapes and primitive values everywhere below an array. Property names, types and nesting still matter.",
            DefaultExampleContext,
            [Verdict("[{ \"age\": 30 }, { \"age\": 31 }]", "[{ \"age\": 99 }]", true, "Both arrays contain the same shape: an object with a numeric age."),
             Verdict("[{ \"age\": 30 }]", "[{ \"age\": \"30\" }]", false, "The age property has a different type.")]),
        NormalizedNamesTip = new("Normalize property names", "Choose whether harmless spelling differences in property names affect matching. This does not change string values.",
            DefaultExampleContext,
            [new("{ \"age\": 30 }", "{ \" Age \": 30 }", "Checked: Match · Unchecked: Different", "text-bg-primary", "Internal spaces and punctuation are still significant.")],
            "Ignore letter case, leading/trailing whitespace and equivalent Unicode forms.",
            "Require identical property names, including case and whitespace."),
        NumericTip = new("Compare numbers by quantity", "Choose whether the written form of a JSON number matters. This rule has no effect in Structure only comparison.",
            DefaultExampleContext,
            [new("{ \"age\": 30 }", "{ \"age\": 30.0 }", "Checked: Match · Unchecked: Different", "text-bg-primary", "There is no rounding tolerance. A number such as 30 never becomes equal to a string such as \"30\".")],
            "Compare exact numeric quantities: 1, 1.0 and 1e0 are equal.",
            "Compare numbers as written: 1 and 1.0 are different."),
        StructuralScoreTip = new("Separate structural score", "Control the additional Structural score in diagnostics. This does not change the main comparison rules or main score.",
            "Example uses Full comparison with default settings.",
            [new("{ \"age\": 30 }", "{ \"age\": 31 }", "Main comparison: Different", "text-bg-primary", "Checked: Structural score is 100% because both ages are numbers. Unchecked: no separate structural score is computed.")],
            "Also compute a score that ignores primitive values. Type and structure differences can lower it.",
            "Skip the extra structural comparison."),
        DecodeJsonTip = new("Decode JSON inside strings", "Choose whether a string containing a valid JSON object or array is compared as that object or array. Applies at the root and at every nested level.",
            DefaultExampleContext,
            [new("{ \"user\": \"{\\\"age\\\":30}\" }", "{ \"user\": { \"age\": 30 } }", "Checked: Match · Unchecked: Different", "text-bg-primary", "Ordinary text and strings containing only a primitive, such as \"30\", stay strings.")],
            "Decode embedded objects and arrays before comparing them.",
            "Keep strings as strings; compare them using the selected string rule.");

    private static readonly TipContent StringsTip = new("String comparison", "Choose how JSON string values match. These rules do not change property names or convert strings into numbers. Structure only comparison ignores string values.",
        "Examples use Full comparison. The Fuzzy example uses threshold 0.8, regardless of the current input.",
        [Verdict("{ \"city\": \"Oslo\" }", "{ \"city\": \" oslo \" }", false,
            "Exact requires identical text, including case and whitespace.", "Exact text"),
         Verdict("{ \"city\": \"Oslo\" }", "{ \"city\": \" oslo \" }", true,
            "Normalized ignores case, outer whitespace and equivalent Unicode forms. Internal spaces and punctuation still matter.", "Normalized"),
         Verdict("{ \"name\": \"John Smith\" }", "{ \"name\": \"Jon Smith\" }", true,
            "Fuzzy also tolerates edits: inserted, deleted, replaced or adjacent swapped characters. Higher thresholds allow fewer edits; short strings tolerate fewer typos.", "Fuzzy at 0.8")]);

    // The scoring mode tips share one pair holding a TypeMismatch and a Missing difference, scored under each mode.
    private static readonly string ModeExampleLeft = Object("\"name\": \"Ann\",\n  \"age\": 30,\n  \"city\": \"Oslo\"");
    private static readonly string ModeExampleRight = Object("\"name\": \"Ann\",\n  \"age\": \"30\"");

    private const string StandardTipText = "Every unmatched node counts at full cost. Custom weights are ignored. The score measures matched content, so a missing subtree can count more than one changed value.";
    private const string WeightedTipText = "Choose how strongly each kind of difference lowers the score: 1 is the smallest penalty and 10 is the Standard penalty. Weights change only the score, not which differences are found.";

    private TipContent FuzzyThresholdTip
    {
        get
        {
            var valid = FuzzyThresholdError is null && fuzzyThreshold.HasValue;
            var threshold = valid ? fuzzyThreshold!.Value : JJMatchSettings.Default.FuzzyThreshold;
            var settings = JJMatchSettings.Default;
            settings.StringComparison = JJStringComparison.Fuzzy;
            settings.FuzzyThreshold = threshold;
            Example FuzzyExample(string right, string explanation)
            {
                const string left = "{ \"name\": \"John Smith\" }";
                return Verdict(left, right, JJMatcher.Match(left, right, settings: settings).Score == 100, explanation);
            }
            return new("Fuzzy similarity threshold",
                "Enter a number from 0 to 1. Higher is stricter. At 1, no edits are allowed after normalization; at 0, any two strings match. Case, outer whitespace and equivalent Unicode forms are ignored at every threshold.",
                $"Examples use Full + Fuzzy at {threshold.ToString("G", CultureInfo.InvariantCulture)}. " +
                    (valid ? "Other settings use defaults." : "The input is invalid; these examples use the default threshold, 0.8."),
                [FuzzyExample("{ \"name\": \"Jon Smith\" }", "One deletion in a 10-character name. Matches at 0.9 or lower."),
                 FuzzyExample("{ \"name\": \"Joan Smyth\" }", "Two replacements in a 10-character name. Matches at 0.8 or lower.")]);
        }
    }

    private TipContent IgnoredPrefixTip
    {
        get
        {
            var active = ignoredPrefix.Length != 0;
            var prefix = active ? ignoredPrefix : "_";
            var name = JsonSerializer.Serialize(prefix + "id", Relaxed);
            // Always choose a different first character, even for an arbitrary user-supplied prefix.
            var keptName = prefix.StartsWith("v", StringComparison.Ordinal) ? "age" : "value";
            var other = JsonSerializer.Serialize(keptName, Relaxed);
            return new("Ignore properties by prefix",
                "Skip properties whose names start with the exact text you enter, at every level in both documents. Skipped properties do not appear in differences or affect scores. Matching is case-sensitive; * is a literal character, not a wildcard. Leave empty to keep every property.",
                active ? $"Examples use prefix {JsonSerializer.Serialize(prefix, Relaxed)} with Full comparison and other settings at defaults."
                    : "The prefix is empty. Examples use Full comparison with default settings; no properties are skipped.",
                [Verdict(Object($"{name}: 1"), Object($"{name}: 2"), active,
                    active ? "This property starts with the prefix, so its value is ignored." : "An underscore has no special meaning unless you enter it as the prefix.", "Property with the example prefix"),
                 Verdict(Object($"{other}: 1"), Object($"{other}: 2"), false,
                    "This property is kept, so the changed value is reported.", "Property without the prefix")]);
        }
    }

    // Tooltip text is rendered by Razor, which escapes it, so the examples can show the prefix as typed.
    private static readonly JsonSerializerOptions Relaxed = new() { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private static string Object(string properties) => "{\n  " + properties + "\n}";

    private static Example Verdict(string left, string right, bool accepted, string? note = null, string heading = "Example") =>
        new(left, right, accepted ? "Match" : "Different", accepted ? "text-bg-success" : "text-bg-danger", note, heading);

    // Scores an example pair under the current settings, in the given mode. The tooltips render on every pass, so
    // an invalid setting is reported instead of thrown, and a library error can never take the page down.
    private Example ScoreExample(string left, string right, JJScoringMode mode)
    {
        if (!SettingsValid)
            return new(left, right, "Settings invalid", "text-bg-warning", "Fix the highlighted settings to see the score.");
        try
        {
            var settings = Settings();
            settings.Scoring.Mode = mode;
            var score = JJMatcher.Match(left, right, scope, settings).Score;
            return new(left, right, $"Score: {Percent(score)}", "text-bg-primary",
                score >= 100 ? "No difference under the current rules, so this weight does not apply." : null);
        }
        catch (Exception exception)
        {
            return new(left, right, "Unavailable", "text-bg-warning", exception.Message);
        }
    }

    private RenderFragment Tip(string key, string text, params Example[] examples) =>
        Tip(key, new TipContent(key switch
        {
            "scoring-standard" => "Standard scoring",
            "scoring-weighted" => "Weighted scoring",
            "weight-missing" => "Penalty for missing content",
            "weight-added" => "Penalty for added content",
            "weight-type" => "Penalty for a different JSON type",
            "weight-value" => "Penalty for a different value",
            "weight-name-case" => "Penalty for property name case differences",
            "weight-value-case" => "Penalty for string case and formatting differences",
            _ => weights.First(weight => weight.Id == key).Name
        }, text, "Live preview: uses your current comparison settings and the scoring mode described here.", examples));

