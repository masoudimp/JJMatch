    private RenderFragment ValueCell(int row, Side side, JsonElement? element)
    {
        if (element is null) return @<span class="text-body-tertiary" aria-label="none">—</span>;
        var text = element.Value.GetRawText();
        var isLong = text.Length > ValuePreviewLength || text.Contains('\n');
        var expanded = expandedValues.Contains((row, side));
        return @<div>
            <pre class="difference-value font-monospace small @(isLong && !expanded ? "clamped" : "")">@text</pre>
            @if (isLong)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ToggleValue(row, side)">@(expanded ? "Show less" : "Show more")</button>
            }
        </div>;
    }

