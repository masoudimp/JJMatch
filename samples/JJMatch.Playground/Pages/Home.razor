    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var init = await JS.InvokeAsync<JsonElement>("jj.init");
                theme = init.GetProperty("theme").GetString() ?? "auto";
                mac = init.GetProperty("mac").GetBoolean();
                StateHasChanged();
            }
            catch (JSException)
            {
            }
        }
        if (revealResults)
        {
            revealResults = false;
            try
            {
                await JS.InvokeVoidAsync("jj.revealResults");
            }
            catch (JSException)
            {
            }
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) Compare();
    }

    private async Task CycleTheme()
    {
        theme = theme switch
        {
            "auto" => "light",
            "light" => "dark",
            _ => "auto"
        };
        try
        {
            await JS.InvokeVoidAsync("jj.setTheme", theme);
        }
        catch (JSException)
        {
        }
    }

    private void LoadExample()
    {
        (left, right) = ExamplePair.Value;
        formatErrors.Clear();
        result = null;
        error = null;
    }

    // Expected and response change places. Missing and Added swap, which is visible in the Weighted score.
    private void Swap()
    {
        (left, right) = (right, left);
        formatErrors.Clear();
        result = null;
        error = null;
    }

    // Wraps the document in a JSON string, which the library decodes again: the root may be stringified too.
    private void Stringify(Side side)
    {
        var text = side == Side.Left ? left : right;
        var stringified = JsonSerializer.Serialize(text, new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
        if (side == Side.Left) left = stringified; else right = stringified;
        formatErrors.Remove(side);
    }

    private void Clear()
    {
        left = "";
        right = "";
        formatErrors.Clear();
        result = null;
        error = null;
    }

    private void SetText(Side side, string? value)
    {
        if (side == Side.Left) left = value ?? ""; else right = value ?? "";
        formatErrors.Remove(side);
    }

    private void OnFuzzyChanged()
    {
        // A disabled input cannot be corrected, so an invalid threshold is reset when Fuzzy is turned off.
        if (!fuzzy && FuzzyThresholdError is not null) fuzzyThreshold = new JJMatchSettings().FuzzyThreshold;
    }

    private void SetScoringMode(JJScoringMode mode)
    {
        scoringMode = mode;
        // Weights are disabled under Standard, so an invalid one is reset to its default rather than left stuck.
        if (mode != JJScoringMode.Weighted)
        {
            foreach (var weight in weights)
            {
                if (WeightError(weight) is not null) weight.Value = weight.Default;
            }
        }
    }

    private void ToggleKind(JJDifferenceKind kind)
    {
        if (!hiddenKinds.Remove(kind)) hiddenKinds.Add(kind);
    }

    private void ToggleValue(int row, Side side)
    {
        if (!expandedValues.Remove((row, side))) expandedValues.Add((row, side));
    }

    // Syntax check of one document, cached per text instance so typing does not re-parse an unchanged side.
    private JsonStatus Status(Side side)
    {
        var text = side == Side.Left ? left : right;
        if (statusCache.TryGetValue(side, out var cached) && ReferenceEquals(cached.Text, text)) return cached.Status;
        var status = CheckJson(text);
        statusCache[side] = (text, status);
        return status;
    }

    private static JsonStatus CheckJson(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new(false, "Empty", "Paste a JSON document.", "text-body-tertiary");
        try
        {
            using var document = JsonDocument.Parse(text, new JsonDocumentOptions { MaxDepth = int.MaxValue });
            var lines = text.AsSpan().Count('\n') + 1;
            return new(true, $"Valid JSON · {lines.ToString(CultureInfo.InvariantCulture)} {(lines == 1 ? "line" : "lines")}", null, "text-success");
        }
        catch (JsonException exception)
        {
            var where = exception.LineNumber is long line ? $" (line {(line + 1).ToString(CultureInfo.InvariantCulture)})" : "";
            return new(false, $"Invalid JSON{where}", exception.Message, "text-danger");
        }
    }

    private void Format(Side side)
    {
        var text = side == Side.Left ? left : right;
        try
        {
            using var document = JsonDocument.Parse(text, new JsonDocumentOptions { MaxDepth = int.MaxValue });
            // The relaxed encoder keeps non-ASCII text and quotes readable; the output is only shown in the text area.
            var pretty = JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
            if (side == Side.Left) left = pretty; else right = pretty;
            formatErrors.Remove(side);
        }
        catch (JsonException exception)
        {
            formatErrors[side] = $"Cannot format: {exception.Message}";
        }
    }

    private void Compare()
    {
        if (!CanCompare) return;
        result = null;
        error = null;
        hiddenKinds.Clear();
        expandedValues.Clear();
        try
        {
            result = JJMatcher.Match(left, right, settings: Settings());
            resultWeighted = scoringMode == JJScoringMode.Weighted;
        }
        catch (Exception exception)
        {
            error = $"{exception.GetType().Name}: {exception.Message}";
        }
        revealResults = true;
    }

    // Only called with valid inputs: SettingsValid guards every caller.
    private JJMatchSettings Settings()
    {
        return new JJMatchSettings
        {
            Mode = scope == JJMatchOptions.StructuralMatching ? JJComparisonMode.StructureOnly : JJComparisonMode.Full,
            IncludeStructuralScore = includeStructuralScore,
            DecodeStringifiedJson = decodeStringifiedJson,
            ArrayMode = arrayMode,
            StringComparison = SelectedStringComparison,
            NumberComparison = numeric ? JJNumberComparison.Numeric : JJNumberComparison.Exact,
            PropertyNameMode = normalizedNames ? JJPropertyNameMatchingMode.Normalized : JJPropertyNameMatchingMode.None,
            IgnoredPropertyPrefix = ignoredPrefix.Length == 0 ? null : ignoredPrefix,
            FuzzyThreshold = fuzzyThreshold!.Value,
            MaxDepth = maxDepth!.Value,
            Scoring =
            {
                Mode = scoringMode,
                MissingWeight = Weight(nameof(JJScoringSettings.MissingWeight)),
                AddedWeight = Weight(nameof(JJScoringSettings.AddedWeight)),
                TypeMismatchWeight = Weight(nameof(JJScoringSettings.TypeMismatchWeight)),
                ValueMismatchWeight = Weight(nameof(JJScoringSettings.ValueMismatchWeight)),
                PropertyNameCaseMismatchWeight = Weight(nameof(JJScoringSettings.PropertyNameCaseMismatchWeight)),
                ValueCaseMismatchWeight = Weight(nameof(JJScoringSettings.ValueCaseMismatchWeight))
            }
        };
    }

    private int Weight(string name) => weights.First(weight => weight.Name == name).Value!.Value;

    // Both exports use the library's canonical configuration, including scope and diagnostics.
    private MarkupString Snippet()
    {
        using var document = JsonDocument.Parse(Settings().ToJson());
        var properties = document.RootElement.EnumerateObject().ToArray();
        if (properties.Length == 0)
            return new MarkupString("var result = JJMatcher.Match(expectedJson, llmResponseJson);");
        var code = "var settings = new JJMatchSettings\n{\n" + Initializer(document.RootElement, "", 4)
            + "\n};\nvar result = JJMatcher.Match(expectedJson, llmResponseJson, settings: settings);";
        return new MarkupString(System.Net.WebUtility.HtmlEncode(code));
    }

    private static string Initializer(JsonElement element, string section, int indent)
    {
        return string.Join(",\n", element.EnumerateObject().Select(property =>
        {
            var padding = new string(' ', indent);
            if (property.Value.ValueKind == JsonValueKind.Object)
                return padding + property.Name + " =\n" + padding + "{\n"
                    + Initializer(property.Value, property.Name, indent + 4) + "\n" + padding + "}";
            var enumType = property.Name switch
            {
                "Mode" => section == "Scoring" ? "JJScoringMode" : "JJComparisonMode",
                "ArrayComparison" => "JJArrayComparison",
                "StringComparison" => "JJStringComparison",
                "NumberComparison" => "JJNumberComparison",
                "PropertyNameMode" => "JJPropertyNameMatchingMode",
                _ => null
            };
            var value = enumType is null ? property.Value.GetRawText() : enumType + "." + property.Value.GetString();
            return padding + property.Name + " = " + value;
        }));
    }

    private MarkupString SettingsJson() => new(System.Net.WebUtility.HtmlEncode(Settings().ToJson()));

    // Copies a rendered snippet as plain text and reports the outcome on the button for a moment. Every tag is a
    // highlighting span around plain tokens, so stripping the tags gives the text as displayed.
    private async Task Copy(string key, MarkupString snippet)
    {
        var copied = false;
        try
        {
            copied = await JS.InvokeAsync<bool>("jj.copy", System.Net.WebUtility.HtmlDecode(Regex.Replace(snippet.Value, "<[^>]+>", "")));
        }
        catch (JSException)
        {
        }
        copyFeedback[key] = copied ? "Copied" : "Copy failed";
        StateHasChanged();
        await Task.Delay(1500);
        copyFeedback.Remove(key);
    }

    private static string Percent(double? value) =>
        value is null ? "n/a" : value.Value.ToString("R", CultureInfo.InvariantCulture) + "%";
}
