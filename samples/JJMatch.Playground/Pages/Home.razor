@page "/"
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>JJMatch Playground</PageTitle>

<div class="container-xl py-4">

<h1 class="h3">JJMatch Playground</h1>
<p class="text-body-secondary">Paste two JSON documents, choose the rules, and compare them with <code>JJMatcher.Match</code>.</p>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label class="form-label fw-semibold" for="left">Expected JSON</label>
        <textarea id="left" class="form-control font-monospace json-input" @bind="left" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 30 }"></textarea>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold" for="right">LLM response JSON</label>
        <textarea id="right" class="form-control font-monospace json-input" @bind="right" spellcheck="false" placeholder="{ &quot;name&quot;: &quot;Ann&quot;, &quot;age&quot;: 31 }"></textarea>
    </div>
</div>

<details class="drawer card mb-3">
<summary class="card-header fw-semibold">Settings</summary>
<div class="card-body">

<div class="row g-4 mb-4">
    <fieldset class="col-md-6 col-xl-4">
        <legend class="fs-6 fw-semibold">Arrays</legend>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="arrays" id="arrays-strict" checked="@(arrayMode == JJArrayMatchingMode.Strict)" @onchange="() => arrayMode = JJArrayMatchingMode.Strict" />
            <label class="form-check-label" for="arrays-strict">Strict (order and count)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="arrays" id="arrays-unordered" checked="@(arrayMode == JJArrayMatchingMode.Unordered)" @onchange="() => arrayMode = JJArrayMatchingMode.Unordered" />
            <label class="form-check-label" for="arrays-unordered">Unordered (count only)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="arrays" id="arrays-structure" checked="@(arrayMode == JJArrayMatchingMode.StructureOnly)" @onchange="() => arrayMode = JJArrayMatchingMode.StructureOnly" />
            <label class="form-check-label" for="arrays-structure">StructureOnly (shapes only)</label>
        </div>
    </fieldset>

    <fieldset class="col-md-6 col-xl-4">
        <legend class="fs-6 fw-semibold">Values (identical always match; rules combined with OR)</legend>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="values-normalized" @bind="normalized" />
            <label class="form-check-label" for="values-normalized">Normalized</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="values-fuzzy" @bind="fuzzy" />
            <label class="form-check-label" for="values-fuzzy">Fuzzy</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="values-numeric" @bind="numeric" />
            <label class="form-check-label" for="values-numeric">Numeric</label>
        </div>
        <label class="form-label mt-2 mb-1" for="fuzzy-threshold">FuzzyThreshold <span class="text-body-secondary">(0 to 1, least similarity Fuzzy accepts)</span></label>
        <input class="form-control form-control-sm number-input" type="number" id="fuzzy-threshold" min="0" max="1" step="0.05" @bind="fuzzyThreshold" />
    </fieldset>

    <fieldset class="col-md-6 col-xl-4">
        <legend class="fs-6 fw-semibold">Property names</legend>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="names" id="names-exact" checked="@(nameMode == JJPropertyNameMatchingMode.Exact)" @onchange="() => nameMode = JJPropertyNameMatchingMode.Exact" />
            <label class="form-check-label" for="names-exact">Exact (character by character)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="names" id="names-normalized" checked="@(nameMode == JJPropertyNameMatchingMode.Normalized)" @onchange="() => nameMode = JJPropertyNameMatchingMode.Normalized" />
            <label class="form-check-label" for="names-normalized">Normalized (case, outer white space and Unicode form ignored)</label>
        </div>
    </fieldset>

    <fieldset class="col-md-6 col-xl-4">
        <legend class="fs-6 fw-semibold">Compare (neither selected means both)</legend>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="compare-structural" @bind="structuralMatching" />
            <label class="form-check-label" for="compare-structural">StructuralMatching</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="compare-value" @bind="valueMatching" />
            <label class="form-check-label" for="compare-value">ValueMatching</label>
        </div>
    </fieldset>

    <fieldset class="col-md-6 col-xl-4">
        <legend class="fs-6 fw-semibold">Limits</legend>
        <label class="form-label mb-1" for="max-depth">MaxDepth <span class="text-body-secondary">(at least 1)</span></label>
        <input class="form-control form-control-sm number-input" type="number" id="max-depth" min="1" @bind="maxDepth" />
    </fieldset>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold">C# for the selected settings</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Copy(Snippet())">Copy</button>
        </div>
        <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-csharp">@Snippet()</code></pre>
    </div>
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold">JJSetting.json for the selected settings</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Copy(SettingsJson())">Copy</button>
        </div>
        <pre class="snippet border rounded bg-body-tertiary p-2 mb-0"><code class="language-json">@SettingsJson()</code></pre>
        <p class="form-text mb-0">Load it with <code>JJMatchSettings.FromJson(File.ReadAllText("JJSetting.json"))</code>.</p>
    </div>
</div>

</div>
</details>

<button class="btn btn-primary mb-3" @onclick="Compare">Compare</button>

@if (error is not null)
{
    <div class="alert alert-danger font-monospace error" role="alert">@error</div>
}
else if (result is not null)
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">IsMatch</div>
                    <span class="badge fs-6 @(result.IsMatch ? "text-bg-success" : "text-bg-danger")">@result.IsMatch</span>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">Score</div>
                    <div class="fs-5 text-break">@Percent(result.Score)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">StructuralMatchPercentage</div>
                    <div class="fs-5 text-break">@Percent(result.StructuralMatchPercentage)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">ValueMatchPercentage</div>
                    <div class="fs-5 text-break">@Percent(result.ValueMatchPercentage)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body py-2">
                    <div class="small text-body-secondary text-break">ElapsedMilliseconds</div>
                    <div class="fs-5 text-break">@result.ElapsedMilliseconds.ToString("0.###", CultureInfo.InvariantCulture) ms</div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Differences <span class="badge text-bg-secondary">@result.Differences.Count</span></h2>
    @if (result.Differences.Count == 0)
    {
        <p class="text-body-secondary">None.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover">
                <thead>
                    <tr><th>Kind</th><th>ScoreWeight</th><th>Left path</th><th>Right path</th><th>Left value</th><th>Right value</th></tr>
                </thead>
                <tbody class="font-monospace small text-break">
                    @foreach (var difference in result.Differences)
                    {
                        <tr>
                            <td>@difference.Kind</td>
                            <td>@difference.ScoreWeight</td>
                            <td>@difference.LeftPath</td>
                            <td>@difference.RightPath</td>
                            <td>@Raw(difference.LeftValue)</td>
                            <td>@Raw(difference.RightValue)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

</div>

@code {
    private string left = "";
    private string right = "";
    private JJMatchResult? result;
    private string? error;

    private JJArrayMatchingMode arrayMode = JJArrayMatchingMode.Strict;
    private JJPropertyNameMatchingMode nameMode = JJPropertyNameMatchingMode.Exact;
    private bool normalized, fuzzy, numeric;
    private bool structuralMatching = true, valueMatching = true;
    private int maxDepth = new JJMatchSettings().MaxDepth;
    private double fuzzyThreshold = new JJMatchSettings().FuzzyThreshold;

    private void Compare()
    {
        result = null;
        error = null;
        try
        {
            result = JJMatcher.Match(left, right, Options(), Settings());
        }
        catch (Exception exception)
        {
            error = $"{exception.GetType().Name}: {exception.Message}";
        }
    }

    // All is zero in the library, so selecting neither option is the same as selecting both.
    private JJMatchOptions Options()
    {
        var options = JJMatchOptions.All;
        if (structuralMatching) options |= JJMatchOptions.StructuralMatching;
        if (valueMatching) options |= JJMatchOptions.ValueMatching;
        return options;
    }

    private JJMatchSettings Settings()
    {
        var valueMode = JJValueMatchingMode.None;
        if (normalized) valueMode |= JJValueMatchingMode.Normalized;
        if (fuzzy) valueMode |= JJValueMatchingMode.Fuzzy;
        if (numeric) valueMode |= JJValueMatchingMode.Numeric;
        return new JJMatchSettings
        {
            ArrayMode = arrayMode,
            ValueMode = valueMode,
            PropertyNameMode = nameMode,
            FuzzyThreshold = fuzzyThreshold,
            MaxDepth = maxDepth
        };
    }

    // The C# code that reproduces the selected settings, built from the same values Compare uses.
    // Rendered as highlighted HTML; every token is an identifier or keyword, so no escaping is needed.
    private MarkupString Snippet()
    {
        var options = Options();
        var settings = Settings();
        var optionsText = options == JJMatchOptions.All
            ? Member(nameof(JJMatchOptions), nameof(JJMatchOptions.All))
            : Flags<JJMatchOptions>(options);
        var valueModeText = settings.ValueMode == JJValueMatchingMode.None
            ? Member(nameof(JJValueMatchingMode), nameof(JJValueMatchingMode.None))
            : Flags<JJValueMatchingMode>(settings.ValueMode);
        var arrayModeText = Member(nameof(JJArrayMatchingMode), settings.ArrayMode.ToString());
        var nameModeText = Member(nameof(JJPropertyNameMatchingMode), settings.PropertyNameMode.ToString());
        var varKeyword = Keyword("var");
        var newKeyword = Keyword("new");
        // Two dollar signs: {{ }} interpolates, so the single braces of the object initializer are literal.
        return new MarkupString($$"""
            {{varKeyword}} settings = {{newKeyword}} {{Type(nameof(JJMatchSettings))}}
            {
                ArrayMode = {{arrayModeText}},
                ValueMode = {{valueModeText}},
                PropertyNameMode = {{nameModeText}},
                FuzzyThreshold = {{Number(settings.FuzzyThreshold)}},
                MaxDepth = {{Number(settings.MaxDepth)}}
            };
            {{varKeyword}} result = {{Type(nameof(JJMatcher))}}.Match(expectedJson, llmResponseJson, {{optionsText}}, settings);
            """);
    }

    // The JJSetting.json that JJMatchSettings.FromJson reads back into the same settings. Rendered as highlighted
    // HTML; names are identifiers and values are member names or digits, so no escaping is needed.
    private MarkupString SettingsJson()
    {
        var settings = Settings();
        var valueModeText = settings.ValueMode == JJValueMatchingMode.None
            ? nameof(JJValueMatchingMode.None)
            : settings.ValueMode.ToString().Replace(", ", " | ");
        return new MarkupString($$"""
            {
              {{Name(nameof(JJMatchSettings.ArrayMode))}}: {{Text(settings.ArrayMode.ToString())}},
              {{Name(nameof(JJMatchSettings.ValueMode))}}: {{Text(valueModeText)}},
              {{Name(nameof(JJMatchSettings.PropertyNameMode))}}: {{Text(settings.PropertyNameMode.ToString())}},
              {{Name(nameof(JJMatchSettings.FuzzyThreshold))}}: {{Number(settings.FuzzyThreshold)}},
              {{Name(nameof(JJMatchSettings.MaxDepth))}}: {{Number(settings.MaxDepth)}}
            }
            """);
    }

    // Copies a rendered snippet as plain text. Every tag is a highlighting span around plain tokens, so stripping
    // the tags gives the text as displayed. Without clipboard access the snippet still selects whole on click.
    private async Task Copy(MarkupString snippet)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Regex.Replace(snippet.Value, "<[^>]+>", ""));
        }
        catch (JSException)
        {
        }
    }

    // Writes a non-zero flags value as "Type.A | Type.B" in declaration order.
    private static string Flags<T>(T value) where T : struct, Enum
    {
        var number = Convert.ToInt64(value, CultureInfo.InvariantCulture);
        var parts = Enum.GetValues<T>()
            .Where(member => Convert.ToInt64(member, CultureInfo.InvariantCulture) is var bit && bit != 0 && (number & bit) == bit)
            .Select(member => Member(typeof(T).Name, member.ToString()));
        return string.Join(" | ", parts);
    }

    private static string Keyword(string text) => $"<span class=\"kw\">{text}</span>";
    private static string Type(string text) => $"<span class=\"ty\">{text}</span>";
    private static string Member(string type, string member) => Type(type) + "." + member;
    private static string Number(int value) => $"<span class=\"num\">{value.ToString(CultureInfo.InvariantCulture)}</span>";
    // "R" keeps every digit of the value, so the snippet reproduces the exact threshold the comparison used.
    private static string Number(double value) => $"<span class=\"num\">{value.ToString("R", CultureInfo.InvariantCulture)}</span>";
    private static string Name(string text) => $"<span class=\"pn\">\"{text}\"</span>";
    private static string Text(string text) => $"<span class=\"str\">\"{text}\"</span>";

    private static string Percent(double? value) =>
        value is null ? "n/a" : value.Value.ToString("R", CultureInfo.InvariantCulture) + "%";

    private static string Raw(JsonElement? element) => element?.GetRawText() ?? "";
}
