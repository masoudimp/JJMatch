        ? @<text></text>
        : @<div class="invalid-feedback">@problem</div>;

    // Settings validation mirrors JJMatchSettings.Snapshot, so nothing that reaches the library can throw there.
    private string? MaxDepthError => maxDepth switch
    {
        null => "Enter a whole number.",
        < 1 => "Must be at least 1.",
        _ => null
    };

    private string? FuzzyThresholdError => fuzzyThreshold switch
    {
        null => "Enter a number.",
        < 0 or > 1 => "Must be between 0 and 1.",
        double value when double.IsNaN(value) => "Must be between 0 and 1.",
        _ => null
    };

    private static string? WeightError(WeightInput weight) => weight.Value switch
    {
        null => "Enter a whole number.",
        < JJScoringSettings.MinWeight or > JJScoringSettings.MaxWeight => $"Must be {JJScoringSettings.MinWeight} to {JJScoringSettings.MaxWeight}.",
        _ => null
    };

    private bool SettingsValid => MaxDepthError is null && FuzzyThresholdError is null && weights.All(weight => WeightError(weight) is null);

    private bool CanCompare => SettingsValid && Status(Side.Left).Ok && Status(Side.Right).Ok;

    private string CompareHint => !SettingsValid ? "Fix the highlighted settings first."
        : !Status(Side.Left).Ok || !Status(Side.Right).Ok ? "Both documents must be valid JSON."
        : $"Compare the two documents ({(mac ? "⌘" : "Ctrl")}+Enter)";

    private string SettingsSummary
    {
        get
        {
            var rules = new List<string>();
            if (normalized) rules.Add("Normalized");
            if (fuzzy) rules.Add(FuzzyThresholdError is null
                ? $"Fuzzy {fuzzyThreshold!.Value.ToString("G", CultureInfo.InvariantCulture)}"
                : "Fuzzy (invalid threshold)");
            if (numeric) rules.Add("Numeric");
            var parts = new[]
            {
                scope == JJMatchOptions.All ? "Structure and values" : scope == JJMatchOptions.StructuralMatching ? "Structure only" : "Values only",
                arrayMode == JJArrayMatchingMode.Strict ? "Unordered arrays" : "Distinct array shapes",
                (normalizedNames ? "Normalized names" : "Identical names") + (ignoredPrefix.Length == 0 ? "" : $", ignoring {ignoredPrefix}…"),
                rules.Count == 0 ? "Identical values" : "Values: " + string.Join(", ", rules),
                $"{scoringMode} scoring",
                $"MaxDepth {maxDepth?.ToString(CultureInfo.InvariantCulture) ?? "?"}"
            };
            return string.Join(" · ", parts);
        }
    }

    private string ThemeLabel => theme switch
