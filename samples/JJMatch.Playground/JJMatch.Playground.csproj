<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <IsPackable>false</IsPackable>
    <!-- Keep full exception messages in the published build, so the UI shows the library's real errors. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JJMatch\JJMatch.csproj" />
  </ItemGroup>

  <!-- The Load example pair is publicApi.playground of the test fixtures, so the pair the page shows is the one
       JJMatcherIntegrationTests pins, and the two cannot drift apart. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\JJMatch.Tests\TestData\ComplexJson\Left.json" LogicalName="Fixtures.Left.json" />
    <EmbeddedResource Include="..\..\tests\JJMatch.Tests\TestData\ComplexJson\Right.json" LogicalName="Fixtures.Right.json" />
  </ItemGroup>

</Project>
